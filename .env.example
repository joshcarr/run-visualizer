# Copy to .env and paste a Nike credential in. .env is gitignored — never commit it.
#
# Nike has no username/password API worth using (the web login sits behind bot
# protection), so the sync borrows a token from a logged-in browser session.
#
# Getting one:
#   1. Log in at https://www.nike.com
#   2. DevTools -> Application -> Local Storage -> https://www.nike.com
#   3. Find the entry whose value is a JSON blob containing "access_token"
#      (the key has "credential" or "oauth" in the name). Right-click the
#      value -> Copy, and paste it as NIKE_CREDENTIAL below, on one line.
#
# The token inside lasts about an hour, so before a sync you generally re-copy
# it. The script says how much life is left and refuses to start on a dead one.

NIKE_CREDENTIAL={"access_token":"...","expires_at":1700000000}

# Alternatives, if you'd rather not paste the whole blob:
#
# Just the token — same one-hour life.
# NIKE_ACCESS_TOKEN=
#
# A refresh token, if you ever get hold of one (the Run Club app has them; the
# nike.com website credential does not). This one keeps working for months —
# the script trades it for a fresh access token on every sync.
# NIKE_REFRESH_TOKEN=
